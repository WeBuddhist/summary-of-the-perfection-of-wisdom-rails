[
 {
  "id": "4-16",
  "tibetan": "བསྟི་སྟང་འདོད་པར་འགྱུར་ཞིང་རྙེད་པ་འདོད་འགྱུར་དང་། ། ལྟ་དང་བཅས་པའི་སེམས་ཀྱིས་ཁྱིམ་འདྲིས་བྱེད་ལྡན་ཞིང་། ། ཆོས་བཏང་ནས་ནི་ཆོས་མིན་བྱ་བ་སྤྱོད་འགྱུར་བ། ། ལམ་བོར་ལམ་གོལ་འགྲོ་བ་འདི་ནི་བདུད་ཀྱི་ལས། །",
  "sanskrit": "सत्कारकाम भविष्यन्ति च लाभकामाः सापेक्षचित्त कुलसंस्तवसंप्रयुक्ताः । छोरित्व धर्म करिष्यन्ति अधर्मकार्यं पथ हित्व उत्पथगता इम मारकर्म ॥",
  "commentaries": {
   "bo-mipham": [
    {
     "id": "4-16",
     "text": "དང་པོ། བསྟི་སྟང་འདོད་པར་སོགས་ཚིགས་བཅད་གཅིག་སྟེ། རང་ཉིད་སྙན་གྲགས་དང་གཞན་གྱིས་བསྟི༷་སྟང༷་བྱ་བ་འདོ༷ད་པར༷་འགྱུར༷་ཞིང༷་། ཡང་ཟས་ནོར་སོགས་རྙེད༷་པ༷་དག་གི་རོ་མྱང་བ་འདོ༷ད་པར་འགྱུར༷་བ་དང༷་། ཕྱི་རོལ་ཡུལ་ལ་ལྟ༷་བར་འདོད་པ་དང༷་བཅས༷་པའི༷་སེམ༷ས་ཀྱིས༷་གྲོང་གི་ཁྱིམ༷་ལ་འདྲིས༷་པའི་བྱེ༷ད་པ་དང་ལྡན༷་ཞིང༷་དེ་དང་དེ་ལྟ་བུ་ལ་སོགས་པ་གཡེངས་པའི་བྱ་བ་སྣ་ཚོགས་ཀྱི་སྒོ་ནས་ཆོས༷་ཟབ་མོ་འདི་འབྲི་བ་དང་མཉན་པ་དང་སེམས་པ་སོགས་བཏང༷་བར་གྱུར་ནས༷་ནི༷། ཆོས༷་མིན༷་པའི་བྱ༷་བ༷་གནས་ངན་ལེན་གྱི་གཞི་གང་ཡང་རུང་བ་ལ་སྤྱོ༷ད་པར་འགྱུར༷་བ༷་གང་ཞིག །ཡང་དག་པའི་ལམ༷་བོར༷་ནས་ལམ༷་མིན་དུ་གོལ༷་ཏེ་འགྲོ༷་བ༷་འདི༷་ནི༷་བདུ༷ད་ཀྱི༷་ལ༷ས་སོ། ། གཞན་ལ་བརྟེན་པ།"
