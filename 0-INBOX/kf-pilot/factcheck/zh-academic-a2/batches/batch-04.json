   "bo-rangjung": [
    {
     "id": "5-106",
     "text": "ཞེས་གསུངས་ཏེ། སྦྱིན་པ་བྱིན་ནས་ཞེས་པ་ནས། ལེགས་ཚོལ་ན་ཞེས་པའི་བར་ལ། ཡང་སྦྱིན་པ་བྱིན་ནས་རྫས་ཀྱི་དངོས་པོ་ལ་གནས་ཤིང་ཆགས་པར་བྱེད་པ་མེད་ལ། བྱང་ཆུབ་སེམས་དཔའ་དེ་ནི་དུས་ནམ་དུ་ཡང་འབྲས་བུ་རྣམ་པར་སྨིན་པ་ལ་རེ་བ་མེད་པའི་ཚུལ་ནི། དེ་ལྟར་སྦྱིན་པ་གཏོང་བ་ལ་མཁས་པ་ཐམས་ཅད་རྒྱུ་འབྲས་ལ་ཆགས་པ་དང་རེ་བ་མེད་པར་གཏོང་བ་སྟེ། བསམ་པའི་སྟོབས་ཆེ་བས་རྒྱུ་ཆུང་ངུས་བཏང་བ་ལ་ཡང་འབྲས་བུ་བཟང་ཞིང་མང་པོ་དཔག་ཏུ་མེད་པར་འགྱུར་ལ། ས་བླ་ས་འོག་ས་སྟེང་གི་སྲིད་པ་གསུམ་ན་སེམས་ཅན་གྱི་གྲངས་མ་ལུས་ཇི་སྙེད་ཡོད་པས། ཡོངས་སུ་བརྟག་པའི་མཐའ་བཟུང་སྟེ་དེ་དག་ཐམས་ཅད་ཀྱང༌། སྦྱིན་པའི་ཡུལ་འཇིག་རྟེན་མཁྱེན་པ་སངས་རྒྱས་དང་དགྲ་བཅོམ་པ་དང༌། རང་རྒྱལ་བ་རྣམས་ལ། དུས་བསྐལ་པ་མཐའ་ཡས་པར་སྦྱིན་པའི་དངོས་པོ་གྱ་ནོམ་པ་སྦྱིན་པ་བྱིན་ནས་འབྲས་བུ་ཉན་ཐོས་ཚོལ་ན་དེ་ནི་བློ་དམན་པའོ། ། གཞན་ཟིལ་གྱི་གནོན་པ།"
    }
   ],
   "bo-khenrab": [
    {
     "id": "5-106",
     "text": "བྱང་སེམས་དེ་དག་གིས་སྦྱིན་པ་བྱིན་ནས་གཏོང་བ་པོ་དང་སྦྱིན་བྱའི་རྫས་དང་ལེན་པ་པོ་སྟེ་འཁོར་གསུམ་གྱི་དངོས་པོ་གང་ལའང་མཚན་མར་མངོན་པར་ཞེན་པའི་ཚུལ་གྱིས་གནས་པར་བྱེད་པ་མེད་ལ།དེ་ཙམ་དུ་མ་ཟད་བྱང་སེམས་དེ་ནི་དུས་ནམ་དུའང་སྦྱིན་པ་དེའི་རྣམ་པར་སྨིན་པ་ལ་ཕན་པ་དང་བདེ་བ་རྒྱ་ཆེན་པོ་བདག་གིས་ཐོབ་པར་འགྱུར་རོ་སྙམ་དུ་རེ་བ་མེད་དེ། སྦྱིན་པ་འབྲས་བུ་དང་བཅས་པ་སེམས་ཅན་ཀུན་ལ་གཏོང་བར་བྱེད་དོ། །བཤད་མ་ཐག་པ་དེ་ལྟར་གཏོང་བའི་བྱང་ཆུབ་སེམས་དཔའ་དེ་ནི་ཐབས་ཤེས་ཁྱད་པར་ཅན་དང་ལྡན་པས་གཏོང་བ་ལ་མཁས་པ་དང་བདོག་པ་གང་ཡོད་རྣམ་སྨིན་གྱི་འབྲས་བུ་དང་བཅས་པ་ཐམས་ཅད་གཏོང་བར་བྱེད་པ་སྟེ། དེ་ལྟ་བུའི་སྒོ་ནས་དངོས་པོ་ཆུང་ངུ་ཞིག་གཏོང་བ་ལ་ཡང་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་མང་པོ་དཔག་ཏུ་མེད་པར་ཐོབ་པར་འགྱུར་རོ། །སེར་སྣ་ཚར་བཅད་པ་དང་རྗེས་སུ་ཡི་རང་བ་སྔོན་དུ་འགྲོ་བས་ཡོངས་སུ་བསྔོ་བ་ལ་གོམས་པར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར་གསུངས་པ། འདོད་པ་དང་གཟུགས་དང་གཟུགས་མེད་དེ་སྲིད་པ་གསུམ་ན་ཡོད་པའི་སེམས་ཅན་གཅིག་ཀྱང་མ་ལུས་པ་ཇི་སྙེད་པ་ཡོངས་སུ་བརྟགས་པ་མཐར་བཟུང་སྟེ་དེ་དག་ཐམས་ཅད་ཀྱིས་ཡུལ་ཁྱད་པར་ཅན་འཇིག་རྟེན་མཁྱེན་པ་སངས་རྒྱས་བཅོམ་ལྡན་འདས་རྣམས་དང་ཉན་ཐོས་དགྲ་བཅོམ་པ་དང་རང་རྒྱལ་རྣམས་ལ་དུས་བསྐལ་པ་མཐའ་ཡས་པའི་བར་དུ་སྦྱིན་པ་རྒྱ་ཆེན་པོ་བྱིན་ཏེ་སྦྱིན་པའི་འབྲས་བུ་ཉན་ཐོས་ཀྱི་བྱང་ཆུབ་ལེགས་པར་ཚོལ་བར་བྱས་ན། རྒྱལ་སྲས་བྱང་ཆུབ་སེམས་དཔའ་གནས་ལུགས་ཀྱི་དོན་ལ་མཁས་པ་ཐབས་ལ་མཁས་ཤིང་སྙིང་རྗེ་ཆེན་པོ་དང་ལྡན་པ་གང་ཞིག་གིས། སེམས་ཀྱི་སྐད་ཅིག་གཅིག་ལ་སྔར་བཤད་པ་དེ་དག་གི་བསོད་ནམས་བྱ་བའི་དངོས་པོ་དེ་ལ་རྗེས་སུ་ཡི་རང་བར་བྱས་ནས་སེམས་ཅན་ཐམསཅད་ཀྱི་དོན་དུ་བྱང་ཆུབ་མཆོག་རབ་སངས་རྒྱས་ཀྱི་གོ་འཕང་ཐོབ་པའི་ཕྱིར་དུ་ཡོངས་སུ་བསྔོ་ན། དེ་ལྟར་ཡོངས་སུ་བསྔོ་བ་ཁྱད་པར་ཅན་དང་ལྡན་པས་འགྲོ་བ་ཐམས་ཅད་ཀྱི་དགེ་བའི་རྩ་མ་ལུས་པ་ཟིལ་གྱིས་མནོན་ཏེ། དཔེར་ན་ནོར་བུ་མཆིང་བུའ …"
