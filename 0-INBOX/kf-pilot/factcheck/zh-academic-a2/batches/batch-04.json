  "tibetan": "གལ་ཏེ་བྱང་ཆུབ་སེམས་དཔའ་འདོད་ཡོན་ལྔ་སྤྱོད་ཀྱང་། ། སངས་རྒྱས་ཆོས་དང་འཕགས་པའི་དགེ་འདུན་སྐྱབས་སོང་སྟེ། ། སངས་རྒྱས་འགྲུབ་བྱ་སྙམ་དུ་ཀུན་མཁྱེན་ཡིད་བྱེད་ན། ། མཁས་པ་ཚུལ་ཁྲིམས་ཕ་རོལ་ཕྱིན་གནས་རིག་པར་བྱ། །",
  "sanskrit": "यदि पञ्च कामगुण भुञ्जति बोधिसत्त्वो बुद्धं च धर्म शरणागतु आर्यसंघम् । सर्वज्ञता च मनसी भविष्यामि बुद्धो स्थितु शीलपारमित वेदयितव्य विज्ञो ॥",
  "commentaries": {
   "bo-mipham": [
    {
     "id": "5-96",
     "text": "དང་པོ། གལ་ཏེ་བྱང་ཆུབ་སོགས་ཚིགས་བཅད་གཅིག་སྟེ། གལ༷་ཏེ༷་བྱང༷་ཆུབ༷་སེམ༷ས་དཔའ༷་ལས་དང་པོ་པ་གང་ཞིག་འདོ༷ད་པའི་ཡོན༷་ཏན་ལྔ༷་ལ་ཞེན་པའི་ཚུལ་གྱིས་སྤྱོ༷ད་པར་གྱུར་ཀྱང༷་། སངས༷་རྒྱས༷་ཆོས༷་དང༷་འཕ༷གས་པའི༷་དགེ༷་འདུན༷་ལ་སྙིང་ནས་སྐྱབས༷་སུ་སོང༷་སྟེ༷། བདག་གིས་སངས༷་རྒྱས༷་ཀྱི་གོ་འཕང་འགྲུབ༷་པར་བྱའོ༷་སྙམ༷་དུ༷་ཀུན༷་མཁྱེན༷་ཡི༷ད་བྱེ༷ད་དང་མ་བྲལ་ན༷། དོན་ལ་མཁས༷་པ༷་དེ་ནི་ཚུལ༷་ཁྲིམས༷་ཀྱི་ཕ༷་རོལ༷་ཏུ་ཕྱིན༷་པ་ལ་གན༷ས་པར་རིགས༷་པར༷་བྱའོ༷། ། ལྡོག་བྱ་དམན་པ།"
    }
